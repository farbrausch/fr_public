/****************************************************************************/

operator GenBitmap ShapeGradient()
{
  column = 0;
  parameter
  {
    flags Size(" 1| 2| 4| 8| 16| 32| 64| 128| 256| 512| 1024| 2048| 4096| 8192"
            ":*8 1| 2| 4| 8| 16| 32| 64| 128| 256| 512| 1024| 2048| 4096| 8192")=0x0808;
    flags Mode("radial|angular|diamond|square") = 0;
    float Center[2](-4..4 step 0.001) = 0.5;
    float Radius(0.001..16 step 0.001) = 0.5;
    float Angle(-4..4 step 0.001) = 0;
    flags Flags("clamp|repeat") = 0;
    array
    {
      float Pos(0..1 step 0.01);
      color Color("rgba");
    }
  }
  code
  {
    out->Init(1<<(para->Size&0xff),1<<((para->Size>>8)&0xff));
    if(cmd->ArrayCount<1) return 0;

    sF32 *pos = new sF32[cmd->ArrayCount];
    sU64 *col = new sU64[cmd->ArrayCount];
    GenBitmapArrayShapeGradient *a = (GenBitmapArrayShapeGradient *) cmd->Array;
    for(sInt i=0;i<cmd->ArrayCount;i++)
    {
      pos[i] = a[i].Pos;
      col[i] = Wz4Extra::Color64(a[i].Color);
    }
    Wz4Extra::ShapeGradient(out->Data,out->XSize,out->YSize,para->Mode,
                            para->Center[0],para->Center[1],para->Radius,para->Angle,
                            pos,col,cmd->ArrayCount,para->Flags&1);
    delete[] pos;
    delete[] col;
  }
}

