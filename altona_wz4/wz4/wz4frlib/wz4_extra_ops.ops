operator GenBitmap Noise()
{
  column = 0;
  parameter
  {
    flags Size(" 1| 2| 4| 8| 16| 32| 64| 128| 256| 512| 1024| 2048| 4096| 8192"
            ":*8 1| 2| 4| 8| 16| 32| 64| 128| 256| 512| 1024| 2048| 4096| 8192")=0x0808;
    int Seed(0..65535) = 1;
    flags Mode("monochrome|colour") = 0;
    float Gamma(0.01..16 step 0.01) = 1;
    color Color0("rgba") = 0xff000000;
    color Color1("rgba") = 0xffffffff;
  }
  code
  {
    out->Init(1<<(para->Size&0xff),1<<((para->Size>>8)&0xff));
    Wz4Extra::Noise(out->Data,out->XSize,out->YSize,para->Seed,para->Mode&1,
                    para->Gamma,Wz4Extra::Color64(para->Color0),Wz4Extra::Color64(para->Color1));
  }
}

