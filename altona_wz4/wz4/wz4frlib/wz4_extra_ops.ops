/****************************************************************************/

operator GenBitmap Wood()
{
  column = 0;
  parameter
  {
    flags Size(" 1| 2| 4| 8| 16| 32| 64| 128| 256| 512| 1024| 2048| 4096| 8192"
            ":*8 1| 2| 4| 8| 16| 32| 64| 128| 256| 512| 1024| 2048| 4096| 8192")=0x0808;
    float Rings(0..256 step 0.1) = 14;
    float Turbulence(0..16 step 0.01) = 0.6;
    int Octaves(1..10) = 4;
    int Seed(0..65535) = 1;
    float Center[2](-4..4 step 0.001) = 0.5;
    float Aspect(0.01..16 step 0.01) = 1;
    color Color0("rgba") = 0xff5a3a1a;
    color Color1("rgba") = 0xffc08040;
  }
  code
  {
    out->Init(1<<(para->Size&0xff),1<<((para->Size>>8)&0xff));
    Wz4Extra::Wood(out->Data,out->XSize,out->YSize,para->Rings,para->Turbulence,
                   para->Octaves,para->Seed,para->Center[0],para->Center[1],
                   para->Aspect,Wz4Extra::Color64(para->Color0),Wz4Extra::Color64(para->Color1));
  }
}

