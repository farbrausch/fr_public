/****************************************************************************/
/***                                                                      ***/
/***   Mesh primitives                                                    ***/
/***                                                                      ***/
/****************************************************************************/

operator Wz4Mesh Icosphere()
{
  column = 0;
  parameter
  {
    int Subdivisions(0..6) = 2;
    float Radius(0..1024 step 0.01) = 0.5;
  }
  code
  {
    Wz4Extra::MakeIcosphere(out,para->Subdivisions,para->Radius);
    out->CalcNormalAndTangents();
  }
}

/****************************************************************************/

operator Wz4Mesh Platonic()
{
  column = 0;
  parameter
  {
    flags Type("tetrahedron|cube|octahedron|dodecahedron|icosahedron") = 4;
    float Radius(0..1024 step 0.01) = 0.5;
  }
  code
  {
    Wz4Extra::MakePlatonic(out,para->Type,para->Radius);
    out->CalcNormalAndTangents();
  }
}

/****************************************************************************/

operator Wz4Mesh TorusKnot()
{
  column = 0;
  parameter
  {
    int P "P (around the axis)" (1..32) = 2;
    int Q "Q (through the hole)" (1..32) = 3;
    int Segments(3..4096) = 256;
    int Slices(3..256) = 12;
    float Radius(0..1024 step 0.01) = 0.5;
    float RingRadius(0..1024 step 0.01) = 0.2;
    float TubeRadius(0..1024 step 0.01) = 0.06;
    flags Flags("open|caps") = 0;
  }
  code
  {
    Wz4Extra::MakeTorusKnot(out,para->P,para->Q,para->Segments,para->Slices,
                            para->Radius,para->RingRadius,para->TubeRadius,para->Flags&1);
    out->CalcNormalAndTangents();
  }
}

/****************************************************************************/

operator Wz4Mesh Supershape()
{
  column = 0;
  parameter
  {
    int Segments "Segments (around)" (3..1024) = 96;
    int Slices "Slices (pole to pole)" (3..1024) = 48;
    float Radius(0..1024 step 0.01) = 0.5;
    group "longitude";
    float M0 "m" (0..64 step 0.01) = 6;
    float N0 "n1,n2,n3" [3] (0.01..64 step 0.01) = { 1, 1, 1 };
    float AB0 "a,b" [2] (0.01..16 step 0.01) = 1;
    group "latitude";
    float M1 "m" (0..64 step 0.01) = 3;
    float N1 "n1,n2,n3" [3] (0.01..64 step 0.01) = { 1, 1, 1 };
    float AB1 "a,b" [2] (0.01..16 step 0.01) = 1;
  }
  code
  {
    sF32 p0[6] = { para->M0,para->N0[0],para->N0[1],para->N0[2],para->AB0[0],para->AB0[1] };
    sF32 p1[6] = { para->M1,para->N1[0],para->N1[1],para->N1[2],para->AB1[0],para->AB1[1] };
    Wz4Extra::MakeSupershape(out,para->Segments,para->Slices,para->Radius,p0,p1);
    out->CalcNormalAndTangents();
  }
}

/****************************************************************************/

operator Wz4Mesh Spring()
{
  column = 0;
  parameter
  {
    float Turns(0.01..1024 step 0.01) = 4;
    float Radius(0..1024 step 0.01) = 0.4;
    float Height(0..1024 step 0.01) = 1;
    int Segments "Segments per turn" (3..256) = 32;
    int Slices(3..256) = 10;
    float TubeRadius(0..1024 step 0.001) = 0.05;
    float Taper(-1..1 step 0.001) = 0;
    flags Flags("open|caps") = 1;
  }
  code
  {
    Wz4Extra::MakeSpring(out,para->Turns,para->Radius,para->Height,para->Segments,
                         para->Slices,para->TubeRadius,para->Taper,para->Flags&1);
    out->CalcNormalAndTangents();
  }
}

/****************************************************************************/

operator Wz4Mesh Lathe()
{
  column = 0;
  parameter
  {
    int Segments(3..4096) = 32;
    float Arc(0.001..1 step 0.001) = 1;
    flags Flags("open|caps") = 1;
    array
    {
      float Radius(0..1024 step 0.01);
      float Height(-1024..1024 step 0.01);
    }
  }
  code
  {
    if(cmd->ArrayCount<2) return 0;
    sF32 *profile = new sF32[cmd->ArrayCount*2];
    Wz4MeshArrayLathe *a = (Wz4MeshArrayLathe *) cmd->Array;
    for(sInt i=0;i<cmd->ArrayCount;i++)
    {
      profile[i*2+0] = a[i].Radius;
      profile[i*2+1] = a[i].Height;
    }
    Wz4Extra::MakeLathe(out,profile,cmd->ArrayCount,para->Segments,para->Arc,para->Flags&1);
    delete[] profile;
    out->CalcNormalAndTangents();
  }
}

/****************************************************************************/
/***                                                                      ***/
/***   Mesh modifiers                                                     ***/
/***                                                                      ***/
/****************************************************************************/

operator Wz4Mesh Shell(Wz4Mesh)
{
  column = 2;
  flags = passinput|passoutput;
  parameter
  {
    float Thickness(-1024..1024 step 0.001) = 0.02;
    flags Mode("outside|inside|centered") = 1;
  }
  code
  {
    Wz4Extra::Shell(out,para->Thickness,para->Mode);
    out->CalcNormalAndTangents();
  }
}

/****************************************************************************/

operator Wz4Mesh Smooth(Wz4Mesh)
{
  column = 1;
  flags = passinput|passoutput;
  parameter
  {
    int Iterations(1..64) = 4;
    float Strength(0..1 step 0.001) = 0.5;
    flags Mode("laplacian|taubin") = 1;
    flags Selection("all|selected|unselected") = 0;
  }
  code
  {
    Wz4Extra::Smooth(out,para->Iterations,para->Strength,para->Mode&1,para->Selection);
    out->CalcNormalAndTangents();
  }
}

/****************************************************************************/

operator Wz4Mesh UVProject(Wz4Mesh)
{
  column = 1;
  flags = passinput|passoutput;
  parameter
  {
    flags Mode("planar|cylindrical|spherical|box") = 0;
    flags UVSet("uv0|uv1") = 0;
    float Tile[2](-1024..1024 step 0.001) = 1;
    float Offset[2](-1024..1024 step 0.001) = 0;
    group "projector";
    float31 Scale(-1024..1024 step 0.01) = { 1,1,1 };
    float30 Rot(-64..64 step 0.001) = { 0,0,0 };
    float31 Trans(-1024..1024 step 0.01) = { 0,0,0 };
  }
  code
  {
    sSRT srt;
    srt.Scale = para->Scale;
    srt.Rotate = para->Rot;
    srt.Translate = para->Trans;
    sMatrix34 mat;
    srt.MakeMatrix(mat);
    Wz4Extra::UVProject(out,para->Mode,para->UVSet,mat,
                        para->Tile[0],para->Tile[1],para->Offset[0],para->Offset[1]);
  }
}

/****************************************************************************/

operator Wz4Mesh Weld(Wz4Mesh)
{
  column = 2;
  flags = passinput|passoutput;
  parameter
  {
    float Threshold(0.000001..1024 step 0.0001) = 0.001;
    flags Flags("keep normals|recalculate normals") = 1;
  }
  code
  {
    Wz4Extra::Weld(out,para->Threshold,para->Flags&1);
  }
}

/****************************************************************************/

// in0 is the surface to cover, in1 is what gets planted on it

operator Wz4Mesh ScatterOnMesh(Wz4Mesh,Wz4Mesh)
{
  column = 3;
  parameter
  {
    int Count(0..16384) = 64;
    int Seed(0..65535) = 1;
    float Scale[2](0.001..1024 step 0.001) = { 0.1, 0.2 };
    float Align(0..1 step 0.001) = 1;
    flags Flags("no spin|random spin:*1drop surface|keep surface") = 3;
  }
  code
  {
    Wz4Extra::ScatterOnMesh(out,in0,in1,para->Count,para->Seed,
                            para->Scale[0],para->Scale[1],para->Align,
                            para->Flags&1,(para->Flags>>1)&1);
    out->CalcNormalAndTangents();
  }
}

