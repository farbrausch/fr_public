/****************************************************************************/
/***                                                                      ***/
/***   Operators the wz3 bitmap generator and the wz4 mesh cannot          ***/
/***   otherwise express. They extend the existing GenBitmap and Wz4Mesh   ***/
/***   types rather than introducing new ones, so they turn up in the      ***/
/***   same columns as everything else.                                   ***/
/***                                                                      ***/
/***   The work happens in wz4_extra_bitmap.cpp and wz4_extra_mesh.cpp.    ***/
/***                                                                      ***/
/****************************************************************************/

header
{
#include "wz4lib/basic_ops.hpp"
#include "wz4frlib/wz3_bitmap_ops.hpp"
#include "wz4frlib/wz3_bitmap_code.hpp"
#include "wz4frlib/wz4_mesh.hpp"
#include "wz4frlib/wz4_mesh_ops.hpp"
}

code
{
#include "wz4frlib/wz4_extra_bitmap.hpp"
#include "wz4frlib/wz4_extra_mesh.hpp"

}

/****************************************************************************/
/***                                                                      ***/
/***   Bitmap generators                                                  ***/
/***                                                                      ***/
/****************************************************************************/

operator GenBitmap Checker()
{
  column = 0;
  parameter
  {
    flags Size(" 1| 2| 4| 8| 16| 32| 64| 128| 256| 512| 1024| 2048| 4096| 8192"
            ":*8 1| 2| 4| 8| 16| 32| 64| 128| 256| 512| 1024| 2048| 4096| 8192")=0x0808;
    int Count[2](1..256) = 8;
    float Offset(-4..4 step 0.01) = 0;
    color Color0("rgba") = 0xff000000;
    color Color1("rgba") = 0xffffffff;
  }
  code
  {
    out->Init(1<<(para->Size&0xff),1<<((para->Size>>8)&0xff));
    Wz4Extra::Checker(out->Data,out->XSize,out->YSize,para->Count[0],para->Count[1],
            para->Offset,Wz4Extra::Color64(para->Color0),Wz4Extra::Color64(para->Color1));
  }
}

/****************************************************************************/

operator GenBitmap Sine()
{
  column = 0;
  parameter
  {
    flags Size(" 1| 2| 4| 8| 16| 32| 64| 128| 256| 512| 1024| 2048| 4096| 8192"
            ":*8 1| 2| 4| 8| 16| 32| 64| 128| 256| 512| 1024| 2048| 4096| 8192")=0x0808;
    int Waves(1..16) = 3;
    float Frequency(0..64 step 0.01) = 3;
    float Angle(-1..1 step 0.001) = 0;
    float Spread(-1..1 step 0.001) = 0.19;
    float Phase(-4..4 step 0.001) = 0;
    float Amplify(0..16 step 0.01) = 1;
    float Gamma(0.01..16 step 0.01) = 1;
    color Color0("rgba") = 0xff000000;
    color Color1("rgba") = 0xffffffff;
  }
  code
  {
    out->Init(1<<(para->Size&0xff),1<<((para->Size>>8)&0xff));
    Wz4Extra::Sine(out->Data,out->XSize,out->YSize,para->Waves,para->Frequency,
         para->Angle,para->Spread,para->Phase,para->Amplify,para->Gamma,
         Wz4Extra::Color64(para->Color0),Wz4Extra::Color64(para->Color1));
  }
}

/****************************************************************************/

operator GenBitmap Julia()
{
  column = 0;
  parameter
  {
    flags Size(" 1| 2| 4| 8| 16| 32| 64| 128| 256| 512| 1024| 2048| 4096| 8192"
            ":*8 1| 2| 4| 8| 16| 32| 64| 128| 256| 512| 1024| 2048| 4096| 8192")=0x0808;
    flags Mode("julia|mandelbrot") = 0;
    if(Mode==0)
    {
      float C[2](-2..2 step 0.0001) = { -0.79, 0.15 };
    }
    float Center[2](-4..4 step 0.0001) = 0;
    float Zoom(0.001..4096 step 0.001) = 0.7;
    int Iterations(1..4096) = 128;
    float Cycle(1..1024 step 0.1) = 24;
    color ColorIn("rgba") = 0xff000000;
    color Color0("rgba") = 0xff204080;
    color Color1("rgba") = 0xffffffff;
  }
  code
  {
    out->Init(1<<(para->Size&0xff),1<<((para->Size>>8)&0xff));
    Wz4Extra::Julia(out->Data,out->XSize,out->YSize,para->Mode==0,para->C[0],para->C[1],
          para->Center[0],para->Center[1],para->Zoom,para->Iterations,para->Cycle,
          Wz4Extra::Color64(para->ColorIn),Wz4Extra::Color64(para->Color0),Wz4Extra::Color64(para->Color1));
  }
}

/****************************************************************************/
/***                                                                      ***/
/***   Bitmap filters                                                     ***/
/***                                                                      ***/
/****************************************************************************/

// in1 is a palette: its first row is the ramp the source is mapped through,
// so a Gradient with a small height is exactly the right thing to feed it.

operator GenBitmap Colorize(GenBitmap,GenBitmap)
{
  column = 1;
  parameter
  {
    flags Channel("luminance|red|green|blue|alpha") = 0;
    flags Flags("replace alpha|keep alpha") = 0;
  }
  code
  {
    out->InitSize(in0);
    Wz4Extra::Colorize(out->Data,in0->Data,out->XSize,out->YSize,
             in1->Data,in1->XSize,para->Channel,para->Flags&1);
  }
}

/****************************************************************************/

operator GenBitmap Morphology(GenBitmap)
{
  column = 1;
  parameter
  {
    flags Mode("erode|dilate|open|close") = 0;
    int Radius(0..64) = 2;
    flags Shape("square|circle") = 1;
    flags Border("clamp|tile") = 0;
  }
  code
  {
    out->InitSize(in0);
    Wz4Extra::Morphology(out->Data,in0->Data,out->XSize,out->YSize,para->Mode,
               para->Radius,para->Shape&1,para->Border&1);
  }
}

/****************************************************************************/

operator GenBitmap Median(GenBitmap)
{
  column = 1;
  parameter
  {
    flags Size("3x3|5x5|7x7") = 0;
    flags Border("clamp|tile") = 0;
  }
  code
  {
    out->InitSize(in0);
    Wz4Extra::Median(out->Data,in0->Data,out->XSize,out->YSize,para->Size+1,para->Border&1);
  }
}

/****************************************************************************/

operator GenBitmap Sobel(GenBitmap)
{
  column = 1;
  parameter
  {
    flags Mode("magnitude|emboss") = 0;
    flags Channel("luminance|red|green|blue|alpha") = 0;
    if(Mode==1)
    {
      float Angle(-1..1 step 0.001) = 0;
    }
    float Amplify(0..64 step 0.01) = 1;
    flags Border("clamp|tile") = 0;
  }
  code
  {
    out->InitSize(in0);
    Wz4Extra::Sobel(out->Data,in0->Data,out->XSize,out->YSize,para->Mode,para->Channel,
          para->Angle,para->Amplify,para->Border&1);
  }
}

