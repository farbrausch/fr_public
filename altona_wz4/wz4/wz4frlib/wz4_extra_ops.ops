/****************************************************************************/

// one input per output channel; leave one unconnected to use the constant

operator GenBitmap Swizzle(?GenBitmap,?GenBitmap,?GenBitmap,?GenBitmap)
{
  column = 1;
  parameter
  {
    flags Red("luminance|red|green|blue|alpha") = 1;
    flags Green("luminance|red|green|blue|alpha") = 2;
    flags Blue("luminance|red|green|blue|alpha") = 3;
    flags Alpha("luminance|red|green|blue|alpha") = 4;
    float Fill[4](0..1 step 0.001) = { 0,0,0,1 };
  }
  code
  {
    GenBitmap *ins[4] = { in0,in1,in2,in3 };
    GenBitmap *first = 0;
    for(sInt i=0;i<4;i++)
      if(ins[i] && !first)
        first = ins[i];
    if(!first) return 0;

    out->InitSize(first);
    for(sInt i=0;i<4;i++)
      if(ins[i] && (ins[i]->XSize!=out->XSize || ins[i]->YSize!=out->YSize))
        return 0;

    const sU64 *src[4];
    sInt ch[4] = { para->Red,para->Green,para->Blue,para->Alpha };
    sF32 fill[4] = { para->Fill[0],para->Fill[1],para->Fill[2],para->Fill[3] };
    for(sInt i=0;i<4;i++)
      src[i] = ins[i] ? ins[i]->Data : 0;

    Wz4Extra::Swizzle(out->Data,out->XSize,out->YSize,src,ch,fill);
  }
}

