operator GenBitmap DistanceField(GenBitmap)
{
  column = 2;
  parameter
  {
    flags Channel("luminance|red|green|blue|alpha") = 0;
    float Threshold(0..1 step 0.001) = 0.5;
    float Range(0.1..1024 step 0.1) = 32;
    flags Border("clamp|tile") = 0;
    color Color0("rgba") = 0xff000000;
    color Color1("rgba") = 0xffffffff;
  }
  code
  {
    out->InitSize(in0);
    Wz4Extra::DistanceField(out->Data,in0->Data,out->XSize,out->YSize,para->Channel,
                  para->Threshold,para->Range,para->Border&1,
                  Wz4Extra::Color64(para->Color0),Wz4Extra::Color64(para->Color1));
  }
}

/****************************************************************************/

operator GenBitmap Kaleidoscope(GenBitmap)
{
  column = 3;
  parameter
  {
    int Sectors(1..256) = 6;
    float Center[2](-4..4 step 0.001) = 0.5;
    float Angle(-4..4 step 0.001) = 0;
    float Zoom(0.001..64 step 0.001) = 1;
    flags Flags("repeat|mirror") = 1;
    flags Border("clamp|tile") = 0;
  }
  code
  {
    out->InitSize(in0);
    Wz4Extra::Kaleidoscope(out->Data,in0->Data,out->XSize,out->YSize,para->Sectors,
                 para->Center[0],para->Center[1],para->Angle,para->Zoom,
                 para->Flags&1,para->Border&1);
  }
}

/****************************************************************************/

// in0 is what gets stamped on, in1 is the stamp

operator GenBitmap Scatter(GenBitmap,GenBitmap)
{
  column = 3;
  parameter
  {
    int Count(0..4096) = 32;
    int Seed(0..65535) = 1;
    float Scale[2](0.001..16 step 0.001) = { 0.1, 0.4 };
    float Angle[2](-4..4 step 0.001) = { 0, 1 };
    float Alpha(0..1 step 0.001) = 1;
    float Tint(0..1 step 0.001) = 0;
    flags Mode("over|add|max") = 0;
    flags Border("clamp|tile") = 1;
  }
  code
  {
    out->InitSize(in0);
    Wz4Extra::Scatter(out->Data,in0->Data,out->XSize,out->YSize,
            in1->Data,in1->XSize,in1->YSize,
            para->Count,para->Seed,para->Scale[0],para->Scale[1],
            para->Angle[0],para->Angle[1],para->Alpha,para->Tint,
            para->Mode,para->Border&1);
  }
}

