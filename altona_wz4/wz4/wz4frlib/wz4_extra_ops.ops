/****************************************************************************/

// one array row is one point of the outline, in both cross sections at once:
// .ops gives an operator a single array, and a loft needs its two profiles to
// pair up point for point anyway

operator Wz4Mesh Loft()
{
  column = 0;
  parameter
  {
    int Steps(1..1024) = 8;
    float Height(0..1024 step 0.01) = 1;
    flags Flags("open|caps") = 1;
    array
    {
      float Bottom[2] (-1024..1024 step 0.01);
      float Top[2] (-1024..1024 step 0.01);
    }
  }
  code
  {
    if(cmd->ArrayCount<3) return 0;
    sF32 *p0 = new sF32[cmd->ArrayCount*2];
    sF32 *p1 = new sF32[cmd->ArrayCount*2];
    Wz4MeshArrayLoft *a = (Wz4MeshArrayLoft *) cmd->Array;
    for(sInt i=0;i<cmd->ArrayCount;i++)
    {
      p0[i*2+0] = a[i].Bottom[0]; p0[i*2+1] = a[i].Bottom[1];
      p1[i*2+0] = a[i].Top[0];    p1[i*2+1] = a[i].Top[1];
    }
    Wz4Extra::MakeLoft(out,p0,p1,cmd->ArrayCount,para->Steps,para->Height,para->Flags&1);
    delete[] p0;
    delete[] p1;
    out->CalcNormalAndTangents();
  }
}

/****************************************************************************/

// the array is the path; the profile is a regular polygon, because the one
// array an operator gets is already spoken for

operator Wz4Mesh Sweep()
{
  column = 0;
  parameter
  {
    int Sides(3..256) = 6;
    float Radius(0..1024 step 0.001) = 0.12;
    float Twist(-64..64 step 0.001) = 0;
    flags Flags("open|closed:*1-|caps") = 2;
    array
    {
      float31 Point(-1024..1024 step 0.01);
    }
  }
  code
  {
    if(cmd->ArrayCount<2) return 0;

    sF32 *profile = new sF32[para->Sides*2];
    for(sInt i=0;i<para->Sides;i++)
    {
      sF32 a = sF32(i)/para->Sides*sPI2F;
      profile[i*2+0] = sFCos(a)*para->Radius;
      profile[i*2+1] = sFSin(a)*para->Radius;
    }

    sF32 *path = new sF32[cmd->ArrayCount*3];
    Wz4MeshArraySweep *a = (Wz4MeshArraySweep *) cmd->Array;
    for(sInt i=0;i<cmd->ArrayCount;i++)
    {
      path[i*3+0] = a[i].Point.x;
      path[i*3+1] = a[i].Point.y;
      path[i*3+2] = a[i].Point.z;
    }

    Wz4Extra::MakeSweep(out,profile,para->Sides,path,cmd->ArrayCount,
                        para->Flags&1,(para->Flags>>1)&1,para->Twist);
    delete[] profile;
    delete[] path;
    out->CalcNormalAndTangents();
  }
}

